# Supabase. VITE_* values are inlined into the client bundle at build time,
# so they must be set when you run `npm run build`. Publishable keys only —
# never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# SSR fallback, read at runtime from process.env when the VITE_* pair is absent.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Base URL for /api calls. Leave empty unless you have a backend to point at —
# this app ships none, and /api/* returns a JSON 404 without it.
VITE_API_BASE=

# Optional: dev-server proxy target for /api (default http://127.0.0.1:8000)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
